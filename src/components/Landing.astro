---
import Image from "astro/components/Image.astro";
import { ArrowRightIcon } from "./icons";
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
const hero = {
  title: `KENTSEL DÖNÜŞÜM HİZMETLERİ`,
  description:
    "Riskli yapı tespitinden yenileme projelerine kadar kentsel dönüşüm süreçlerinizin tüm aşamalarında yanınızdayız.",
  image: `${base}nurdoganlanding1.jpeg`,
};
---

<section
  class="relative w-full min-h-[calc(100vh-5rem)] overflow-hidden"
  id="hero-slider"
  aria-label="Ana tanıtım"
>
  <div class="relative flex min-h-[calc(100vh-5rem)] w-full flex-col items-center justify-center px-4 py-16 md:py-24">
    <div class="absolute inset-0 z-0">
      <Image
        src={hero.image}
        alt=""
        width={1920}
        height={1080}
        class="h-full w-full object-cover"
      />
    </div>
    <div class="absolute inset-0 z-10 bg-black/35 dark:bg-black/45"></div>
    <div class="relative z-20 flex w-full flex-col items-center px-[clamp(1rem,calc(0.5rem+1.6vw),2rem)] text-center">
      <div class="flex w-full flex-col items-center gap-[clamp(0.875rem,calc(0.5rem+1.4vw),1.5rem)]">
        <h2 class="w-full max-w-[min(100%,60rem)] text-[clamp(1.75rem,calc(0.92rem+2vw),3rem)] font-semibold leading-[1.12] tracking-wide text-white drop-shadow-md">
          {hero.title}
        </h2>
        <p class="w-full max-w-[min(100%,44rem)] text-[clamp(1rem,calc(0.72rem+0.75vw),1.4375rem)] leading-relaxed text-white drop-shadow-sm">
          {hero.description}
        </p>
      </div>
      <div class="mt-6 flex w-full max-w-[min(100%,44rem)] flex-col items-stretch justify-center gap-3 sm:mt-8 sm:max-w-none sm:flex-row sm:items-center sm:gap-4">
        <a
          href={`${base}hizmetler`}
          class="inline-flex min-h-[3rem] flex-1 items-center justify-center gap-2 rounded-full bg-[#E30A17] px-6 py-3.5 text-base font-medium text-white shadow-md shadow-black/25 transition-colors hover:bg-[#c00914] sm:min-h-0 sm:flex-initial sm:px-7 sm:py-4 sm:text-lg"
        >
          Hizmetleri Keşfedin
          <ArrowRightIcon color="#fff" />
        </a>
        <button
          type="button"
          class="open-teklif-modal inline-flex min-h-[3rem] flex-1 cursor-pointer items-center justify-center rounded-full border-2 border-white bg-white/5 px-6 py-3.5 text-base font-medium text-white backdrop-blur-[2px] transition-colors hover:bg-white/20 sm:min-h-0 sm:flex-initial sm:px-7 sm:py-4 sm:text-lg"
        >
          Hemen Teklif Al
        </button>
      </div>
    </div>
  </div>
</section>
