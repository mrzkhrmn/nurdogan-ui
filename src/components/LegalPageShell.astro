---
import MainLayout from "../layouts/MainLayout.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<MainLayout>
  <div class="w-full bg-gray-50 dark:bg-gray-900 min-h-[50vh] transition-colors">
    <article class="max-w-3xl mx-auto px-4 md:px-6 py-10 md:py-14 lg:py-16 text-gray-900 dark:text-gray-100">
      <header class="mb-8 md:mb-10 border-b border-gray-200 dark:border-gray-700 pb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-[#262322] dark:text-gray-100 tracking-tight">
          {title}
        </h1>
        {lead && <p class="mt-3 text-base text-gray-600 dark:text-gray-400 leading-relaxed">{lead}</p>}
        <p class="mt-4 text-sm text-gray-500 dark:text-gray-500">Son güncelleme: 30 Nisan 2026</p>
      </header>
      <div class="space-y-8 text-[15px] md:text-base leading-relaxed text-gray-700 dark:text-gray-300 [&_h2]:text-lg [&_h2]:md:text-xl [&_h2]:font-semibold [&_h2]:text-[#262322] [&_h2]:dark:text-gray-100 [&_h2]:mt-0 [&_h2]:mb-3 [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-gray-800 [&_h3]:dark:text-gray-200 [&_h3]:mt-5 [&_h3]:mb-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-2 [&_p]:mb-3 [&_a]:text-[#E30A17] [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:opacity-90">
        <slot />
      </div>
    </article>
  </div>
  <Footer />
</MainLayout>
