---
interface Props {
  beforeSrc: string;
  afterSrc: string;
  beforeAlt?: string;
  afterAlt?: string;
  /** 0..100 */
  initialPercent?: number;
  beforeLabel?: string;
  afterLabel?: string;
  showLabels?: boolean;
  className?: string;
}

const {
  beforeSrc,
  afterSrc,
  beforeAlt = "Önce",
  afterAlt = "Sonra",
  initialPercent = 50,
  beforeLabel = "Eski",
  afterLabel = "Yeni",
  showLabels = true,
  className = "",
} = Astro.props;

const uid = `ba-${Math.random().toString(36).slice(2, 9)}`;
const safeInitial = Number.isFinite(initialPercent)
  ? Math.min(100, Math.max(0, Math.round(initialPercent)))
  : 50;
---

<div class={`before-after ${className}`} data-before-after id={uid} style={`--ba:${safeInitial}%`}>
  <div class="before-after__media" aria-label="Önce / Sonra karşılaştırma">
    <img class="before-after__img before-after__img--before" src={beforeSrc} alt={beforeAlt} loading="lazy" />
    <div class="before-after__after" aria-hidden="true">
      <img class="before-after__img before-after__img--after" src={afterSrc} alt={afterAlt} loading="lazy" />
    </div>

    <div class="before-after__handle" aria-hidden="true">
      <div class="before-after__line"></div>
      <div class="before-after__knob" title="Sürükle">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>

    <input
      class="before-after__range"
      type="range"
      min="0"
      max="100"
      value={safeInitial}
      aria-label="Önce/sonra karşılaştırma sürgüsü"
    />
  </div>

  {showLabels && (
    <div class="before-after__labels" aria-hidden="true">
      <div class="before-after__label before-after__label--before">
        <span class="before-after__label-sub"><</span>
        <span class="before-after__label-title">{beforeLabel}</span>
      </div>
      <div class="before-after__label before-after__label--after">
        <span class="before-after__label-title">Yeni</span>
        <span class="before-after__label-title">></span>
      </div>
    </div>
  )}
</div>

<script is:inline>
  (function () {
    function init(root) {
      var range = root.querySelector(".before-after__range");
      var media = root.querySelector(".before-after__media");
      if (!range || !media) return;

      function setValue(v) {
        var n = Math.max(0, Math.min(100, Number(v) || 0));
        range.value = String(n);
        root.style.setProperty("--ba", n + "%");
      }

      setValue(range.value);
      range.addEventListener("input", function () {
        setValue(range.value);
      });

      function updateFromClientX(clientX) {
        var r = media.getBoundingClientRect();
        var x = clientX - r.left;
        var p = (x / r.width) * 100;
        setValue(p);
      }

      media.addEventListener("pointerdown", function (e) {
        if (!e || e.button !== undefined && e.button !== 0) return;
        media.setPointerCapture && media.setPointerCapture(e.pointerId);
        updateFromClientX(e.clientX);
      });
      media.addEventListener("pointermove", function (e) {
        if (!e || !(e.buttons & 1)) return;
        updateFromClientX(e.clientX);
      });
    }

    document.querySelectorAll("[data-before-after]").forEach(init);
  })();
</script>

<style>
  .before-after {
    width: 100%;
  }

  .before-after__media {
    position: relative;
    width: 100%;
    height: clamp(220px, 28vw, 420px);
    border-radius: 1.25rem;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.12);
    user-select: none;
    touch-action: none;
  }

  :global(.dark) .before-after__media {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.35);
  }

  .before-after__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .before-after__img--before,
  .before-after__img--after {
    position: absolute;
    inset: 0;
  }

  .before-after__after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--ba, 50%));
    will-change: clip-path;
  }

  .before-after__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--ba, 50%);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .before-after__line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  :global(.dark) .before-after__line {
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.35);
  }

  .before-after__knob {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: #262322;
    border: 1px solid rgba(0, 0, 0, 0.12);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(8px);
  }

  :global(.dark) .before-after__knob {
    background: rgba(17, 24, 39, 0.88);
    color: rgba(255, 255, 255, 0.92);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
  }

  .before-after__range {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .before-after__labels {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .before-after__label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: #262322;
    backdrop-filter: blur(8px);
  }

  :global(.dark) .before-after__label {
    background: rgba(17, 24, 39, 0.72);
    border-color: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.92);
  }

  .before-after__label-title {
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .before-after__label-sub {
    font-size: 0.875rem;
    opacity: 0.75;
    white-space: nowrap;
  }
</style>

