---
import Image from "astro/components/Image.astro";
import { YouTubeIcon, InstagramIcon } from "./icons";

const baseUrl = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");

const pages = [
  { label: "Ana Sayfa", href: baseUrl },
  { label: "Hakkımızda", href: `${baseUrl}#hakkimizda` },
  { label: "Projeler", href: `${baseUrl}projeler` },
  { label: "Haberler", href: `${baseUrl}haberler` },
  { label: "İletişim", href: `${baseUrl}iletisim` },
  { label: "Teklif Al", href: `${baseUrl}teklif-al` },
];
---

<footer id="iletisim" class="w-full bg-[#E30A17] dark:bg-gray-950 text-white transition-colors duration-200">
  <div class="border-b border-white/10">
    <div class="max-w-[1200px] mx-auto px-4 md:px-6 lg:px-8 py-12 md:py-14">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
        <!-- Logo / marka -->
        <div class="space-y-5">
          <Image
            src={`${baseUrl}new-logo.png`}
            alt="Nurdoğan Babadağ"
            width={140}
            height={82}
            loading="lazy"
            class="block w-28 h-auto bg-white p-1.5 rounded-lg"
          />
          <p class="text-white/90 text-sm leading-relaxed max-w-[240px]">
            Kentsel dönüşüm ve proje yönetiminde güvenilir çözüm ortağınız.
          </p>
          <div class="flex items-center gap-3 pt-1">
            <a
              href="https://www.youtube.com/@nurdoganb"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-full border border-white/30 flex items-center justify-center hover:bg-white/10 transition-colors"
              aria-label="YouTube"
            >
              <YouTubeIcon width={18} height={18} />
            </a>
            <a
              href="https://www.instagram.com/nurdoganbabadag/"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-full border border-white/30 flex items-center justify-center hover:bg-white/10 transition-colors"
              aria-label="Instagram"
            >
              <InstagramIcon width={18} height={18} />
            </a>
          </div>
        </div>

        <!-- Sayfalar -->
        <div>
          <h4 class="text-white text-base md:text-lg font-semibold mb-5 pb-2 border-b border-white/20">
            Sayfalar
          </h4>
          <nav class="flex flex-col gap-2.5">
            {pages.map((page) => (
              <a
                href={page.href}
                class="text-white/90 text-sm md:text-[15px] hover:text-white transition-colors"
              >
                {page.label}
              </a>
            ))}
          </nav>
        </div>

        <!-- Yasal -->
        <div>
          <h4 class="text-white text-base md:text-lg font-semibold mb-5 pb-2 border-b border-white/20">
            Yasal
          </h4>
          <nav class="flex flex-col gap-2.5">
            <a href={`${baseUrl}kullanim-sartlari`} class="text-white/90 text-sm md:text-[15px] hover:text-white transition-colors">
              Kullanım Şartları
            </a>
            <a href={`${baseUrl}gizlilik-politikasi`} class="text-white/90 text-sm md:text-[15px] hover:text-white transition-colors">
              Gizlilik Politikası
            </a>
            <a href={`${baseUrl}cerezler`} class="text-white/90 text-sm md:text-[15px] hover:text-white transition-colors">
              Çerezler
            </a>
          </nav>
        </div>

        <!-- İletişim -->
        <div>
          <h4 class="text-white text-base md:text-lg font-semibold mb-5 pb-2 border-b border-white/20">
            İletişim
          </h4>
          <div class="space-y-5 text-sm md:text-[15px]">
            <div>
              <p class="font-semibold text-white mb-1.5">Telefon:</p>
              <a href="tel:+905306544317" class="block text-white/90 hover:text-white transition-colors">
                +90 530 654 43 17
              </a>
              <a href="tel:+905326126544" class="block text-white/90 hover:text-white transition-colors">
                +90 532 612 65 44
              </a>
            </div>
            <div>
              <p class="font-semibold text-white mb-1.5">Mail:</p>
              <a href="mailto:info@nurdoganbabadag.com" class="block text-white/90 hover:text-white transition-colors break-all">
                info@nurdoganbabadag.com
              </a>
            </div>
             <div>
              <p class="font-semibold text-white mb-1.5">Kep:</p>
              <a href="mailto:mekakentseldonusum@hs01.kep.tr" class="block text-white/90 hover:text-white transition-colors break-all mt-1">
                mekakentseldonusum@hs01.kep.tr
              </a>
            </div>
            <div>
              <p class="font-semibold text-white mb-1.5">Adres:</p>
              <p class="text-white/90 leading-relaxed">
                Caddebostan Mah. Bağdat Cd. Alevok Apt. No:275 Kat:1 Daire:2 Kadıköy / İSTANBUL
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="w-full bg-[#333333] px-4 md:px-6 lg:px-8 py-5 md:py-6">
    <p class="max-w-[1200px] mx-auto text-white text-center text-sm md:text-base">
      Copyright © {new Date().getFullYear()} <span class="text-[#E30A17]">Nurdoğan Babadağ</span> — Tüm Hakları Saklıdır.
    </p>
  </div>
</footer>
