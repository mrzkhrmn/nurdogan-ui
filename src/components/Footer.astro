---
import Image from "astro/components/Image.astro";
import {
  YouTubeIcon,
  InstagramIcon,
  PhoneIcon,
  MailIcon,
  LocationIcon,
  KepIcon,
} from "./icons";

const baseUrl = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
const year = new Date().getFullYear();

const pages = [
  { label: "Ana Sayfa", href: baseUrl },
  { label: "Hakkımızda", href: `${baseUrl}#hakkimizda` },
  { label: "Projeler", href: `${baseUrl}projeler` },
  { label: "Hizmetlerimiz", href: `${baseUrl}hizmetler` },
  { label: "Referanslar", href: `${baseUrl}#bina-yonetimi` },
  { label: "İletişim", href: `${baseUrl}iletisim` },
  { label: "Teklif Al", href: "#", isTeklif: true },
];

const legalLinks = [
  { label: "Kullanım Şartları", href: `${baseUrl}kullanim-sartlari` },
  { label: "Gizlilik Politikası", href: `${baseUrl}gizlilik-politikasi` },
  { label: "Çerezler", href: `${baseUrl}cerezler` },
  { label: "KVKK Aydınlatma Metni", href: `${baseUrl}gizlilik-politikasi` },
];

const features = [
  {
    title: "Güvenli Yapılar",
    description: "Riskli yapı tespiti ve güvenli dönüşüm süreçleri.",
    icon: "shield",
  },
  {
    title: "Proje Yönetimi",
    description: "Planlama, uygulama ve teslim sürecinde tam kontrol.",
    icon: "building",
  },
];
---

<footer class="relative w-full text-white overflow-hidden">
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style={`background-image: url('${baseUrl}about-us.jpg')`}
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-[#5a0a10]/88"
    style="background: linear-gradient(180deg, rgba(90, 8, 14, 0.92) 0%, rgba(70, 6, 12, 0.94) 45%, rgba(45, 4, 8, 0.96) 100%);"
    aria-hidden="true"
  ></div>

  <div class="relative z-10">
    <div class="max-w-[1440px] mx-auto px-4 md:px-6 lg:px-10 xl:px-12 py-12 md:py-14 lg:py-16">
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-10 xl:gap-0">
        <!-- Marka -->
        <div class="xl:pr-8 space-y-5">
          <Image
            src={`${baseUrl}new-logo.png`}
            alt="Nurdoğan Babadağ"
            width={160}
            height={94}
            loading="lazy"
            class="block w-36 h-auto"
          />
          <p class="text-white/90 text-sm leading-relaxed max-w-[280px]">
            Kentsel dönüşüm ve proje yönetiminde uzman kadromuzla, güvenli, modern
            ve yaşanabilir yapılar için çözüm üretiyoruz.
          </p>

          <div class="space-y-3">
            {features.map((feature) => (
              <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-md bg-[#E30A17] flex items-center justify-center shrink-0 mt-0.5">
                  {feature.icon === "shield" ? (
                    <svg class="w-[18px] h-[18px] text-white" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M12 3l7 3v5c0 4.5-3 7.8-7 9-4-1.2-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                      <path d="M9.5 12l1.8 1.8L15 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  ) : (
                    <svg class="w-[18px] h-[18px] text-white" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M4 20V9l8-5 8 5v11" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                      <path d="M9 20v-6h6v6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                    </svg>
                  )}
                </div>
                <div>
                  <p class="text-white text-sm font-semibold leading-tight">{feature.title}</p>
                  <p class="text-white/75 text-xs leading-relaxed mt-1">{feature.description}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="pt-2">
            <p class="text-white text-sm font-semibold mb-3">Bizi Takip Edin</p>
            <div class="flex items-center gap-3">
              <a
                href="https://www.youtube.com/@nurdoganb"
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 rounded-full border border-[#d4af37]/70 flex items-center justify-center hover:bg-white/10 transition-colors"
                aria-label="YouTube"
              >
                <YouTubeIcon width={16} height={12} />
              </a>
              <a
                href="https://www.instagram.com/nurdoganbabadag/"
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 rounded-full border border-[#d4af37]/70 flex items-center justify-center hover:bg-white/10 transition-colors"
                aria-label="Instagram"
              >
                <InstagramIcon width={16} height={16} color="#FFFFFF" />
              </a>
            </div>
          </div>
        </div>

        <!-- Sayfalar -->
        <div class="xl:px-8 xl:border-l border-white/20">
          <h4 class="text-white text-base md:text-lg font-semibold mb-5 inline-block pb-2 border-b-2 border-[#d4af37]">
            Sayfalar
          </h4>
          <nav class="flex flex-col gap-3">
            {pages.map((page) =>
              page.isTeklif ? (
                <button
                  type="button"
                  class="open-teklif-modal group flex items-center gap-2 text-left text-white/90 text-sm md:text-[15px] hover:text-white transition-colors"
                >
                  <span class="text-[#d4af37] text-xs leading-none">›</span>
                  {page.label}
                </button>
              ) : (
                <a
                  href={page.href}
                  class="group flex items-center gap-2 text-white/90 text-sm md:text-[15px] hover:text-white transition-colors"
                >
                  <span class="text-[#d4af37] text-xs leading-none">›</span>
                  {page.label}
                </a>
              )
            )}
          </nav>
        </div>

        <!-- Yasal -->
        <div class="xl:px-8 xl:border-l border-white/20">
          <h4 class="text-white text-base md:text-lg font-semibold mb-5 inline-block pb-2 border-b-2 border-[#d4af37]">
            Yasal
          </h4>
          <nav class="flex flex-col gap-3">
            {legalLinks.map((link) => (
              <a
                href={link.href}
                class="group flex items-center gap-2 text-white/90 text-sm md:text-[15px] hover:text-white transition-colors"
              >
                <span class="text-[#d4af37] text-xs leading-none">›</span>
                {link.label}
              </a>
            ))}
          </nav>
        </div>

        <!-- İletişim -->
        <div class="xl:pl-8 xl:border-l border-white/20">
          <h4 class="text-white text-base md:text-lg font-semibold mb-5 inline-block pb-2 border-b-2 border-[#d4af37]">
            İletişim
          </h4>
          <div class="space-y-4 text-sm md:text-[15px]">
            <div class="flex items-start gap-3 pb-4 border-b border-white/15">
              <div class="w-10 h-10 rounded-lg bg-[#E30A17] flex items-center justify-center shrink-0">
                <PhoneIcon color="#FFFFFF" width={18} height={18} />
              </div>
              <div class="min-w-0">
                <p class="font-semibold text-white mb-1">Telefon</p>
                <a href="tel:+905306544317" class="block text-white/90 hover:text-white transition-colors">
                  +90 530 654 43 17
                </a>
                <a href="tel:+905326126544" class="block text-white/90 hover:text-white transition-colors">
                  +90 532 612 65 44
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3 pb-4 border-b border-white/15">
              <div class="w-10 h-10 rounded-lg bg-[#E30A17] flex items-center justify-center shrink-0 [&_svg]:w-[18px] [&_svg]:h-auto">
                <MailIcon color="#FFFFFF" />
              </div>
              <div class="min-w-0">
                <p class="font-semibold text-white mb-1">E-Posta</p>
                <a
                  href="mailto:info@nurdoganbabadag.com"
                  class="block text-white/90 hover:text-white transition-colors break-all"
                >
                  info@nurdoganbabadag.com
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3 pb-4 border-b border-white/15">
              <div class="w-10 h-10 rounded-lg bg-[#E30A17] flex items-center justify-center shrink-0 [&_svg]:w-7 [&_svg]:h-auto">
                <KepIcon />
              </div>
              <div class="min-w-0">
                <p class="font-semibold text-white mb-1">Kep Adresi</p>
                <a
                  href="mailto:mekakentseldonusum@hs01.kep.tr"
                  class="block text-white/90 hover:text-white transition-colors break-all"
                >
                  mekakentseldonusum@hs01.kep.tr
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-[#E30A17] flex items-center justify-center shrink-0 [&_svg]:w-[16px] [&_svg]:h-auto">
                <LocationIcon color="#FFFFFF" />
              </div>
              <div class="min-w-0">
                <p class="font-semibold text-white mb-1">Adres</p>
                <p class="text-white/90 leading-relaxed">
                  Caddebostan Mah. Bağdat Cd. Alevok Apt. No:275 Kat:1 Daire:2
                  Kadıköy / İSTANBUL
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="w-full bg-[#1a1a1a] border-t border-white/10">
      <div class="max-w-[1440px] mx-auto px-4 md:px-6 lg:px-10 xl:px-12 py-4 md:py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <p class="text-white/90 text-xs sm:text-sm">
          © {year} NURDOĞAN BABADAĞ — Tüm Hakları Saklıdır.
        </p>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs sm:text-sm text-white/80">
          <a href={baseUrl} class="hover:text-white transition-colors">Site Haritası</a>
          <span class="text-white/40" aria-hidden="true">|</span>
          <a href={`${baseUrl}gizlilik-politikasi`} class="hover:text-white transition-colors">KVKK</a>
          <span class="text-white/40" aria-hidden="true">|</span>
          <button
            type="button"
            id="open-cookie-settings"
            class="hover:text-white transition-colors"
          >
            Çerez Ayarları
          </button>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  document.getElementById("open-cookie-settings")?.addEventListener("click", () => {
    const banner = document.getElementById("cookie-consent-banner");
    if (!banner) return;
    try {
      localStorage.removeItem("nurdogan-cookie-consent");
    } catch (_) {}
    banner.classList.remove("hidden");
  });
</script>
