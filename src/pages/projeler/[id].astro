---
import MainLayout from "../../layouts/MainLayout.astro";
import Footer from "../../components/Footer.astro";
import ProjeDetayDinamik from "../../components/ProjeDetayDinamik.jsx";
import { BASE_API_URL } from "../../api/constants";
import { completedProjects as staticCompleted, ongoingProjects as staticOngoing } from "../../data/projects";

const baseUrl = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");

/** Build sırasında bilinen projeler için statik kabuk üretir; detay istemci tarafında API'den gelir. */
export async function getStaticPaths() {
  const paths: { params: { id: string } }[] = [];
  try {
    const res = await fetch(`${BASE_API_URL}/Website/get-projects`, {
      headers: { Accept: "application/json" },
    });
    if (res.ok) {
      const projects = (await res.json()) as { id: string }[];
      projects.forEach((p) => paths.push({ params: { id: p.id } }));
    }
  } catch (_) {
    // API yoksa statik proje slug'ları ile path üret (build hata vermesin)
  }
  if (paths.length === 0) {
    const all = [...staticCompleted, ...staticOngoing];
    all.forEach((p) => paths.push({ params: { id: p.slug } }));
  }
  return paths;
}
---

<MainLayout>
  <ProjeDetayDinamik client:load baseUrl={baseUrl} />
  <Footer />
</MainLayout>
