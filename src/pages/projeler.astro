---
import MainLayout from "../layouts/MainLayout.astro";
import Footer from "../components/Footer.astro";
import ProjelerPageProjectsClient from "../components/ProjelerPageProjectsClient.jsx";
// import FeaturedProjectsCarousel from "../components/FeaturedProjectsCarousel.jsx";

const baseUrl = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
---

<MainLayout>
  <div class="w-full min-h-screen transition-colors duration-200">
    <!-- <FeaturedProjectsCarousel client:load baseUrl={baseUrl} /> -->

    <section class="relative w-full pt-28 sm:pt-32 md:pt-36 lg:pt-40 pb-12 md:pb-20 px-4 md:px-6 bg-cover bg-top bg-no-repeat" style={`background-image: url('${baseUrl}projelerim-bg.png')`}>
      <div class="absolute inset-0 z-0 bg-white/80 dark:bg-gray-900/70" aria-hidden="true" />
      <div class="relative z-10 max-w-[1480px] mx-auto">
        <h1 class="text-[#262322] dark:text-gray-100 text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight mb-6 md:mb-8">
          Projelerimiz ve Referanslarımız
        </h1>

        <div class="projeler-intro  mb-10 md:mb-14 space-y-6 md:space-y-8 ">
          <p class="text-[#525252] dark:text-gray-300 text-base sm:text-lg md:text-xl leading-relaxed md:leading-[1.75]">
            <span class=" text-[#E30A17] dark:text-red-400 font-semibold text-lg sm:text-xl md:text-2xl tracking-tight">
              NURDOĞAN BABADAĞ
            </span>
            <span class="text-[#262322] dark:text-gray-100 font-medium">, Kentsel Dönüşüm Proje Yönetimi ve Danışmanlık Ltd. Şti.</span>
            olarak; mimari projelendirme ve sözleşme hazırlığından
            <span class="text-[#E30A17] dark:text-red-400 font-semibold"> Yüklenici seçimine</span>,
            riskli yapı tespitinden inşaat imalat sürecinin takibi ve iskân alımına kadar
            kentsel dönüşümün tüm aşamalarında maliklerin haklarını koruyan
            <span class="text-[#262322] dark:text-gray-100 font-semibold"> profesyonel danışmanlık hizmeti</span>
            sunuyoruz.
          </p>
          <p class="text-[#585858] dark:text-gray-400 text-sm sm:text-base md:text-lg leading-relaxed md:leading-[1.8] font-[family-name:var(--font-family-manrope)]">
            <span class="text-[#E30A17] dark:text-red-400 font-bold">15 yılı aşkın</span>
            bilgi ve tecrübemizle yürüttüğümüz
            <span class="text-[#262322] dark:text-gray-200 font-semibold"> devam eden projelerimizi</span>
            ve başarıyla tamamlanan
            <span class="text-[#262322] dark:text-gray-200 font-semibold"> proje referanslarımızı</span>
            sayfamızda detaylıca inceleyebilirsiniz.
          </p>
        </div>

        <ProjelerPageProjectsClient client:load baseUrl={baseUrl} />
      </div>
    </section>
  </div>

  <Footer />
</MainLayout>

<style>
  .project-page-tab {
    cursor: pointer;
  }
  .project-page-tab:not(.active-tab) {
    color: #262322;
  }
  :global(.dark) .project-page-tab:not(.active-tab) {
    color: #e5e7eb;
  }
  .project-page-tab:hover {
    color: #E30A17;
  }
  .project-page-tab.active-tab {
    color: #E30A17;
    border-bottom-color: #E30A17;
  }
</style>
